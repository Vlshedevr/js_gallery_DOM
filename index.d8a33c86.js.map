var pictureContainer = document.querySelector("#thumbs");
var largeImg = document.querySelector("#largeImg");
pictureContainer.addEventListener("click", function(ev) {
    var imgLink = ev.target.closest(".list-item__link");
    if (imgLink) {
        ev.preventDefault();
        var newLargeImg = imgLink.getAttribute("href");
        largeImg.setAttribute("src", newLargeImg);
    }
});

